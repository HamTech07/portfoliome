# Frontend (set this in Vercel after the Render service is live)
VITE_ASSISTANT_API_URL=/api/chat

# Backend (set these in Render; never commit the real API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
MAX_DAILY_REQUESTS=200
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://your-portfolio-domain.vercel.app
PORT=8787

# Admin content and uploaded files. Use a persistent disk in production.
DATA_DIR=.portfolio-data

# Portfolio Admin Supabase project. Use the project URL and browser-safe
# publishable key (or legacy anon key). Never use service_role here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
